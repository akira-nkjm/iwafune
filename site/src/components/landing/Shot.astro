---
// 画面写真。Astro の画像処理で AVIF / WebP の複数の幅を出す。縦横比を先に決めておくので、読み込みで配置が動かない。
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** 画面での幅の見積もり（sizes 属性）。 */
  sizes: string;
  widths: number[];
}
const { src, alt, sizes, widths } = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  sizes={sizes}
  widths={widths}
  formats={["avif", "webp"]}
  fallbackFormat="png"
  loading="lazy"
  decoding="async"
  class="shot-img"
  style={`aspect-ratio: ${src.width} / ${src.height}`}
/>

<style>
  .shot-img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
