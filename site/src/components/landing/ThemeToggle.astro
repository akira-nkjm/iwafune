---
// 明るい配色と暗い配色の切り替え。選びは Starlight と同じキー（starlight-theme）に保存するので、docs のページと共通になる。
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button type="button" class="theme-toggle" aria-label={label} title={label}>
  <svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--iw-line-strong);
    border-radius: var(--iw-radius-sm);
    background: transparent;
    color: var(--iw-ink-3);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--iw-ink);
    background: var(--iw-panel-2);
  }
  .icon-sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .icon-sun {
    display: block;
  }
  :global(:root[data-theme="dark"]) .icon-moon {
    display: none;
  }
</style>

<script>
  const KEY = "starlight-theme";
  document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((button) => {
    button.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem(KEY, next);
      } catch {
        // 保存できなくても、このページの中では切り替わる。
      }
    });
  });
</script>
