{
  "name": "iwafune-site",
  "description": "Documentation and onboarding website for iwafune (Astro, Starlight)",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host localhost --port 4321",
    "build": "astro build",
    "preview": "astro preview --host localhost --port 4321",
    "check": "astro check",
    "typecheck": "astro check",
    "test": "vitest run",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "shots": "node scripts/capture-shots.ts",
    "check:dist": "node scripts/check-dist.ts"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.8",
    "@astrojs/starlight": "0.42.11",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "astro": "7.4.11",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.7",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "mdast-util-to-string": "4.0.0",
    "playwright-core": "1.65.1",
    "remark-parse": "11.0.0",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "vfile": "6.0.3",
    "vitest": "5.1.0"
  }
}
